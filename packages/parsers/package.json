{
  "name": "@marqum/parsers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bank statement (PDF/CSV) and notification parsers.",
  "exports": {
    ".": "./src/index.ts",
    "./pdf": "./src/pdf-lines.ts"
  },
  "scripts": {

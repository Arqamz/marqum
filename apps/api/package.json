    "e2e": "bash test/e2e.sh"
  },
  "dependencies": {
    "@marqum/core": "workspace:*",
    "@marqum/parsers": "workspace:*",
    "@marqum/schema": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "hono": "4.13.17",
    "ulidx": "2.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@marqum/config": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}

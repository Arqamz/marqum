{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marqum",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "09abb782bf38f116f993da799ee6e023",
  "workers_dev": true,
  "observability": { "enabled": true },
  // The web app (apps/web) is built into ../web/dist and served by this Worker; /api/* runs the Worker first.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marqum",
      "database_id": "9193251e-08f6-4ad0-8a9f-a724aa736c56",
      "migrations_dir": "migrations"
    }
  ],
  // Bucket lock rules (configured on the bucket): sealed/ kept indefinitely, nightly/ kept 90 days.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "marqum-backups" }],
  // Nightly export at 21:00 UTC = 02:00 Asia/Karachi
  "triggers": { "crons": ["0 21 * * *"] }
  // Secrets (wrangler secret put …): PASSCODE (initial passcode), TOKEN_PEPPER
}
